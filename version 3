import turtle
import random

wn = turtle.Screen()
alex = turtle.Turtle()

colors = ["red", "orange", "yellow", "green", "blue", "purple"]
lines_per_color = 4

random.shuffle(colors)

for x in range(300):
    color_index = (x // lines_per_color) % len(colors)
    alex.pencolor(colors[color_index])
    alex.pensize(x / 100 + 1)
    alex.forward(x)
    alex.left(59)